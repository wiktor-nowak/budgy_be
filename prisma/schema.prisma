// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output   =  "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  username String
  email String @unique
  role Role @default(USER)
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  //Optional
  name String?
  surname String?

  // Relations
  ownedAccounts Account[] @relation("UserAccounts")
  sharedAccounts UserToAccount[]

  @@unique([id])
}

model Account {
  id Int @id @default(autoincrement())
  name String
  type AccountType
  balance Decimal
  lastMonthlyBalance Decimal
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  owner User? @relation("UserAccounts", fields: [ownerId], references: [id])
  ownerId Int? // @unique(if: "type = 'CASH'")
  coOwners UserToAccount[]
  expenses Expense[] @relation("AccountExpenses")
  monthlyBalances MonthlyBalance[] @relation("AccountBalances")
}

model UserToAccount {
  // Relations
  user       User     @relation(fields: [userId], references: [id])
  userId   Int
  account   Account @relation(fields: [accountId], references: [id])
  accountId Int
  assignedAt DateTime @default(now())

  @@id([userId, accountId])
}

model MonthlyBalance {
  id Int @id @default(autoincrement())
  balance Decimal
  month Month
  year Int

  // Relations
  account Account @relation("AccountBalances", fields: [accountId], references: [id])
  accountId Int @unique
}

model Expense {
  id Int @id @default(autoincrement())
  amount Decimal
  shared Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  account Account @relation("AccountExpenses", fields: [accountId], references: [id])
  accountId Int
  category Category @relation("ExpenseCategory", fields: [categoryId], references: [id])
  categoryId Int
}

model Category {
  id Int @id @default(autoincrement())
  name String
  shortcut String
  expenses Expense[] @relation("ExpenseCategory")
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  CASH
  BANK
  SHARED
}

enum Month {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
}
