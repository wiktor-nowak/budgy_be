// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output   =  "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid(7))
  username String
  email String @unique
  role Role @default(USER)
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  //Optional
  name String?
  surname String?

  // Relations
  ownedAccounts Account[]
  sharedAccounts UserToAccount[]

  @@unique([id])
}

model Account {
  id  String   @id @default(cuid()) @db.VarChar(30)
  name String
  type AccountType
  balance Decimal
  lastMonthlyBalance Decimal
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  owner User? @relation(fields: [ownerId], references: [id])
  ownerId String? @unique
  coOwners UserToAccount[]
  expenses Expense[]
  monthlyBalances MonthlyBalance[] @relation("AccountBalances")
  
  @@unique([id])
}

model UserToAccount {
  // Relations
  user User @relation(fields: [userId], references: [id])
  userId String @unique
  account  Account @relation(fields: [accountId], references: [id])
  accountId  String @db.VarChar(30) @unique
  assignedAt DateTime @default(now())

  @@id([userId, accountId])
}

model MonthlyBalance {
  id String @id @default(cuid()) @db.VarChar(30)

  balance Decimal
  month Month
  year Int

  // Relations
  account Account @relation("AccountBalances", fields: [accountId], references: [id])
  accountId String @db.VarChar(30) @unique

  @@unique([id])
}

model Expense {
  id String @id @default(cuid()) @db.VarChar(30)

  amount Decimal
  shared Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  account Account @relation(fields: [accountId], references: [id])
  accountId String @db.VarChar(30) @unique
  category Category @relation(fields: [categoryId], references: [id])
  categoryId String @db.VarChar(30) @unique

  @@unique([id])
}

model Category {
  id String   @id @default(cuid()) @db.VarChar(30)
  name String
  shortcut String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  expenses Expense[]

  @@unique([id])
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  CASH
  BANK
  SHARED
}

enum Month {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
}
