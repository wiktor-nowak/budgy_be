// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   =  "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid
  username String
  email String @unique
  role Role @default(USER)
  password String
  isVerified Boolean @default(false)

  // Time / Date fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  verifiedAt DateTime?
  
  //Optional
  name String @default("")
  surname String @default("")
  mainAccountId String?

  // Relations
  ownedAccounts Account[]
  sharedAccounts UserToAccount[]
  refreshTokens RefreshToken[]
  emailTokens EmailVerificationToken[]
}

model Account {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  type          AccountType
  description   String?

  // Running balance (derived, updated atomically)
  balance     Decimal  @db.Decimal(14, 2) @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  ownerId           String?  @db.Uuid
  owner             User?    @relation(fields: [ownerId], references: [id])
  coOwners          UserToAccount[] 
  transactions      Transaction[]
  monthlySummaries  MonthlySummary[]
  categories        Category[]

  @@index([ownerId])
}

model UserToAccount {
  // Relations
  user User @relation(fields: [userId], references: [id])
  userId String @db.Uuid
  account  Account @relation(fields: [accountId], references: [id])
  accountId  String @db.Uuid
  assignedAt DateTime @default(now())

  @@id([userId, accountId])
}

model Transaction {
  id              String   @id @default(uuid()) @db.Uuid
  amount          Decimal  @db.Decimal(14, 2) // signed (+income / -expense)
  transactionDate DateTime // business date (critical)
  description     String?

  // DB Values
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  accountId       String   @db.Uuid
  account         Account  @relation(fields: [accountId], references: [id])
  categoryId      String   @db.Uuid
  category        Category @relation(fields: [categoryId], references: [id])

  @@index([accountId, transactionDate])
  @@index([accountId, categoryId])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  shortcut  String

  // DB Values
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accountId                 String   @db.Uuid
  account                   Account  @relation(fields: [accountId], references: [id])
  transactions              Transaction[]
  monthlyCategorySummaries  MonthlyCategorySummary[]

  @@unique([accountId, shortcut])
  @@index([accountId])
}

model MonthlySummary {
  id            String   @id @default(uuid()) @db.Uuid
  year          Int
  month         Int      // 1–12
  openingBalance Decimal @db.Decimal(14, 2)
  totalIncome    Decimal @db.Decimal(14, 2)
  totalExpense   Decimal @db.Decimal(14, 2)
  closingBalance Decimal @db.Decimal(14, 2)

  // DB Values
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Realtions
  accountId     String   @db.Uuid
  account       Account  @relation(fields: [accountId], references: [id])
  categorySummaries MonthlyCategorySummary[]

  @@unique([accountId, year, month])
  @@index([accountId])
}

model MonthlyCategorySummary {
  id               String   @id @default(uuid()) @db.Uuid
  totalAmount      Decimal  @db.Decimal(14, 2)

  // Relations
  monthlySummaryId String   @db.Uuid
  monthlySummary   MonthlySummary @relation(fields: [monthlySummaryId], references: [id])
  categoryId       String   @db.Uuid
  category         Category @relation(fields: [categoryId], references: [id])

  @@unique([monthlySummaryId, categoryId])
}

model RefreshToken {
  tokenHash   String   @id @db.Text
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
  expiresAt   DateTime
  replacedBy  String?  @db.Text
  revoked     Boolean  @default(false)
}


model EmailVerificationToken {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  userId  String @db.Uuid
  user    User @relation(fields: [userId], references: [id])
}


enum Role {
  USER
  ADMIN
  VISITOR
}

enum AccountType {
  CASH
  BANK
  SHARED
}


